# Independent implementations written by agents from the specifications
# alone (see README.md): spec/archive.md readers and writers in rust/, typescript/
# and python/, and spec/virtualize.md virtualizers in virtualize/.

set shell := ["bash", "-euo", "pipefail", "-c"]

mod rust
mod typescript
mod python
mod virtualize

[private]
default:
    @just --list --list-submodules

# Build whatever needs building
build: rust::build virtualize::build

# Run every implementation's own tests
test: rust::test typescript::test python::test
