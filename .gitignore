*.vzip
design/experiments/out/ng_demo/expected.npy

# Conformance and comparison outputs
conformance/results/

# Test scratch output
conformance/impls/typescript/test/.tmp/

# The IR core's build output
rust/refkv-ir/target/
# the archive writer's, the phkv crate's and the CLI's (rust/refkv-vzip, rust/refkv-phkv, rust/refkv-cli)
rust/refkv-vzip/target/
rust/refkv-phkv/target/
rust/refkv-cli/target/
# the Python bindings' build output
python/target/

# the Python bindings to the Rust core, compiled into the package by `uv sync` (python/pyproject.toml)
python/src/refkv/_core*.so
python/src/refkv/_core*.pyd
# and its earlier name, in checkouts built before the bindings moved to python/
python/src/refkv/_ir*.so
python/src/refkv/_ir*.pyd
