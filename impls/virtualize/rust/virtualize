#!/usr/bin/env bash
# Build (if needed) and run the Rust virtualizer: virtualize <url> <out.json>
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bin="$here/target/release/virtualize"
if [[ ! -x "$bin" ]] || [[ -n "$(find "$here/src" "$here/Cargo.toml" -newer "$bin" 2>/dev/null)" ]]; then
  cargo build --release --offline --quiet --manifest-path "$here/Cargo.toml" >&2
fi
exec "$bin" "$@"
