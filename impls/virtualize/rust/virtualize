#!/usr/bin/env bash
set -euo pipefail
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bin="$dir/target/release/virtualize"
if [[ ! -x "$bin" || -n "$(find "$dir/src" "$dir/Cargo.toml" -newer "$bin" 2>/dev/null | head -n1)" ]]; then
  (cd "$dir" && cargo build --release --offline --quiet) >&2
fi
exec "$bin" "$@"
