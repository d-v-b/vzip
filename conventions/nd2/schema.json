{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/d-v-b/vzip/refs/heads/main/conventions/nd2/schema.json",
  "title": "vzip ND2 convention, version 0",
  "description": "The zarr.json of a node that declares the vzip ND2 convention (https://github.com/d-v-b/vzip/blob/main/conventions/nd2/README.md)",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "const": 3
    },
    "node_type": {
      "type": "string",
      "enum": [
        "group",
        "array"
      ]
    },
    "attributes": {
      "type": "object",
      "properties": {
        "ome": {
          "type": "object",
          "description": "OME-NGFF 0.5 metadata"
        },
        "zarr_conventions": {
          "type": "array",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          },
          "minContains": 1,
          "maxContains": 1
        },
        "vzip_virtualized": {
          "oneOf": [
            {
              "$ref": "#/$defs/rootProperty"
            },
            {
              "$ref": "#/$defs/nodeProperty"
            }
          ]
        }
      },
      "required": [
        "zarr_conventions",
        "vzip_virtualized"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "zarr_format",
    "node_type",
    "attributes"
  ],
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "The ND2 convention's metadata object in zarr_conventions",
      "properties": {
        "uuid": {
          "type": "string",
          "const": "59612f14-e314-4207-ba00-8f422ba71490"
        },
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/d-v-b/vzip/refs/heads/main/conventions/nd2/schema.json"
        },
        "spec_url": {
          "type": "string",
          "const": "https://github.com/d-v-b/vzip/blob/main/conventions/nd2/README.md"
        },
        "name": {
          "type": "string",
          "const": "vzip_virtualized"
        },
        "description": {
          "type": "string",
          "const": "The Zarr layout of a ND2 source virtualized by vzip, and the source's metadata"
        }
      },
      "required": [
        "uuid"
      ],
      "additionalProperties": false
    },
    "rootProperty": {
      "type": "object",
      "description": "The root's property: the profile and version that produced the hierarchy, its source, and the root's source metadata",
      "properties": {
        "profile": {
          "type": "string",
          "const": "nd2"
        },
        "version": {
          "type": "integer",
          "const": 0
        },
        "revision": {
          "type": "integer",
          "const": 24,
          "description": "The VIRTUALIZE.md revision that produced the hierarchy (version 0 only)"
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL of the source file"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "nd2": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "required": [
        "profile",
        "version",
        "revision",
        "source"
      ],
      "additionalProperties": false
    },
    "sourceMetadata": {
      "anyOf": [
        {
          "type": "object",
          "description": "The root's: the signature and the decoded chunks it keeps (conventions/nd2/README.md §5)",
          "properties": {
            "signature": {
              "$ref": "#/$defs/text",
              "description": "The signature chunk's data up to its first NUL"
            },
            "chunks": {
              "type": "object",
              "description": "Each decoded chunk (lite variant or XML variant) the root keeps, by name, as a JSON tree: an object, or [name, value] pairs when a name repeats, when a name is an array index (0, 1, ... without leading zeros), or when the object would read as a tag ({\"utf16\": B}, {\"int\": digits}, {\"float\": \"NaN\"|\"Infinity\"|\"-Infinity\"|\"-0\"}); at most 65536 bytes of JSON in all",
              "additionalProperties": {
                "type": [
                  "object",
                  "array"
                ]
              }
            }
          },
          "required": [
            "signature",
            "chunks"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/mirror"
        },
        {
          "$ref": "#/$defs/mirrorView"
        }
      ]
    },
    "headerValue": {
      "description": "A translated header value (conventions/README.md §6)",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      ]
    },
    "text": {
      "description": "A text value: a string (UTF-8), or its ISO 8859-1 reading when it is not UTF-8",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "latin1": {
              "type": "string"
            }
          },
          "required": [
            "latin1"
          ],
          "additionalProperties": false
        }
      ]
    },
    "mirror": {
      "type": "object",
      "description": "vzip_source's: the IR mirror's description (conventions/README.md §8.2)",
      "properties": {
        "ir": {
          "type": "object",
          "properties": {
            "version": {
              "const": 2
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "description": "The source's size in bytes"
            },
            "elements": {
              "type": "integer",
              "minimum": 1,
              "description": "The elements, column runs expanded"
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "description": "The rows the table stores"
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "const": ""
                }
              ],
              "description": "The interned names, sorted; the first, \"\", is the root's (conventions §8.1)"
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "const": ""
                }
              ],
              "description": "The interned types (§8.6)"
            },
            "forms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The interned forms, each a JSON text (§8.5)"
            }
          },
          "required": [
            "version",
            "size",
            "elements",
            "rows",
            "names",
            "types",
            "forms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ir"
      ],
      "additionalProperties": false
    },
    "mirrorView": {
      "type": "object",
      "description": "A view group's (vzip_source/tree/...): a struct's view document (conventions/README.md §8.7)",
      "properties": {
        "$vz": {
          "const": "derived",
          "description": "A derived element's document"
        },
        "$form": {
          "type": [
            "string",
            "null"
          ],
          "description": "A derived element's form (§8.5)"
        },
        "$partial": {
          "const": true,
          "description": "The document stops short of the struct's children"
        }
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/viewValue"
      }
    },
    "viewValue": {
      "description": "A child's view: a JSON value, a nested document, or a $vz form",
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null",
            "array"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$vz": {
              "enum": [
                "alias",
                "group",
                "element",
                "derived",
                "int",
                "float",
                "bytes",
                "utf16"
              ]
            }
          },
          "required": [
            "$vz"
          ]
        },
        {
          "type": "object"
        }
      ]
    },
    "nodeProperty": {
      "type": "object",
      "description": "Any other node's property: its source metadata only",
      "properties": {
        "nd2": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "required": [
        "nd2"
      ],
      "additionalProperties": false
    }
  }
}
